{
  "name": "rivals-arena",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --env-file-if-exists=.env --test",
    "db:init": "node --env-file-if-exists=.env scripts/db.js init",
    "db:seed": "node --env-file-if-exists=.env scripts/db.js seed",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.js migrate"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.24.6"
  }
}
